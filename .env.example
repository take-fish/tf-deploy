# FishMatrix 集中机环境变量（复制为 .env 并按需修改；全部变量在 compose 中均有默认值）
# ── MySQL：生产/测试物理隔离 ──
MYSQL_ROOT_PASSWORD=fishmatrix
# fm-mysql（生产实例）发布到宿主机的端口（本机 3306 可能被原生 MySQL 占用，默认 13306）
MYSQL_HOST_PORT=13306
# fm-test-mysql（测试实例）独立 root 密码与端口，必须与生产不同
TEST_MYSQL_ROOT_PASSWORD=
TEST_MYSQL_HOST_PORT=13307
TEST_MYSQL_HOST=mysql-test
TEST_MYSQL_PORT=3306
REDIS_PORT=6379
ES_PORT=9200
NACOS_PORT=8848
GATEWAY_PORT=8080
TF_GATEWAY_TAG=latest
CONSOLE_PORT=8301
TF_CONSOLE_TAG=latest
WEB_PORT=8088
TF_WEB_TAG=latest
# 流水线控制台（tf-console）用的 GitHub token：只读即可（classic 无 scope / fine-grained 只读 public 权限），
# 用途仅是把 API 配额从匿名 60/h 提升到 5000/h；留空则控制台自动降级（30 分钟一轮 + 页面提示）
GITHUB_TOKEN=

# ── 统一日志检索（Loki / Alloy / Grafana）──
# Loki / Grafana 只发布到宿主机回环地址，避免日志接口直接暴露给局域网
LOKI_PORT=13100
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
# 由 scripts/ensure-observability-secrets.sh 生成；仅在宿主机回环端口登录 Grafana
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://127.0.0.1:13000
# 流水线中台“日志检索”的口令；由 scripts/ensure-observability-secrets.sh 生成
# 留空时接口不校验口令，仅建议在本机临时调试时使用
TF_CONSOLE_LOG_TOKEN=
# 控制台访问 Loki 的地址；容器内默认 http://loki:3100
LOKI_URL=

# ── 网关上游（默认使用集中机 compose 服务名；分机服务可改为 http://<IP>:<端口>）──
# 留空即使用 compose 默认值
TF_CHAT_URL=
TF_READER_URL=
TF_GAME_URL=
TF_MUSIC_URL=
TF_USER_URL=

# ── 业务服务层（docker-compose.services.yml）──
NACOS_USERNAME=nacos
NACOS_ADMIN_PASSWORD=
# 生产业务容器不再由应用启动建表/写 seed；schema 由 Flyway 迁移任务管理
SQL_INIT_MODE=never
# 管理员自动同步开关：生产默认关闭，首次初始化/轮换密码时显式设为 true
USER_ADMIN_SEED_ENABLED=false

# 旧共享账号：仅保留用于回滚；生产切换完成后按第 20.4.4 节退场
MYSQL_APP_USER=fm_app
MYSQL_APP_PASSWORD=

# 生产每服务运行时账号（只授 DML，不授 DDL）
FM_USER_DB_USER=fm_user_app
FM_USER_DB_PASSWORD=
FM_CHAT_DB_USER=fm_chat_app
FM_CHAT_DB_PASSWORD=
FM_READER_DB_USER=fm_reader_app
FM_READER_DB_PASSWORD=
FM_GAME_DB_USER=fm_game_app
FM_GAME_DB_PASSWORD=
FM_MUSIC_DB_USER=fm_music_app
FM_MUSIC_DB_PASSWORD=

# 生产每服务迁移账号（只给一次性迁移 Job，不注入业务容器）
FM_USER_DB_MIGRATE_USER=fm_user_migrate
FM_USER_DB_MIGRATE_PASSWORD=
FM_CHAT_DB_MIGRATE_USER=fm_chat_migrate
FM_CHAT_DB_MIGRATE_PASSWORD=
FM_READER_DB_MIGRATE_USER=fm_reader_migrate
FM_READER_DB_MIGRATE_PASSWORD=
FM_GAME_DB_MIGRATE_USER=fm_game_migrate
FM_GAME_DB_MIGRATE_PASSWORD=
FM_MUSIC_DB_MIGRATE_USER=fm_music_migrate
FM_MUSIC_DB_MIGRATE_PASSWORD=

# ── Nacos 鉴权（第 4 步启用）──
# NACOS_AUTH_TOKEN 需为 base64 编码、解码后 ≥32 字节；生成示例：
#   openssl rand -base64 32
NACOS_AUTH_ENABLE=false
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# ── Nacos 分级账号（密码由 scripts/ensure-nacos-secrets.sh 生成）──
# 网关只读：目标 namespace 只读；应用读写：配置读 + 服务注册；配置管理：发布配置
GATEWAY_NACOS_USERNAME=fm-gateway-ro-prod
GATEWAY_NACOS_PASSWORD=
FM_APP_NACOS_USERNAME=fm-app-rw-prod
FM_APP_NACOS_PASSWORD=
FM_CONFIG_ADMIN_USERNAME=fm-config-admin
FM_CONFIG_ADMIN_PASSWORD=
# 网关总开关：回滚时可设为 false，直接使用静态 TF_*_URL
GATEWAY_DISCOVERY_ENABLED=true
# 注册到 Nacos 的构建信息（可选；不填时 version=dev、git-commit=unknown）
APP_VERSION=
GIT_COMMIT=

# 测试环境 Nacos 分级账号
TEST_GATEWAY_NACOS_USERNAME=fm-gateway-ro-test
TEST_GATEWAY_NACOS_PASSWORD=
TEST_FM_APP_NACOS_USERNAME=fm-app-rw-test
TEST_FM_APP_NACOS_PASSWORD=
# 测试实例的注册 metadata（对应 compose 中的 APP_VERSION / GIT_COMMIT）
TEST_APP_VERSION=test
TEST_GIT_COMMIT=

# tf-user 管理员账号（用户中台审批用；密码留空时由 scripts/ensure-user-admin-secrets.sh 生成）
USER_ADMIN_USERNAME=admin
USER_ADMIN_PASSWORD=

# 业务服务端口与镜像 tag（默认即可；固定版本时改 tag）
USER_PORT=8101
CHAT_PORT=8102
READER_PORT=8103
GAME_PORT=8104
MUSIC_PORT=8105
TF_USER_TAG=latest
TF_CHAT_TAG=latest
TF_READER_TAG=latest
TF_GAME_TAG=latest
TF_MUSIC_TAG=latest

# 分机部署时覆盖为集中机地址（集中机全栈运行保留默认 mysql/redis/nacos:8848）
# MYSQL_HOST=10.28.13.214
# REDIS_HOST=10.28.13.214
# NACOS_ADDR=10.28.13.214:8848

# ── 测试环境（docker-compose.test.yml，独立测试 MySQL + 共享 Redis/Nacos）──
# MySQL 使用独立实例 fm-test-mysql（compose 服务名 mysql-test）；
# Redis 共享实例 DB1；Nacos 共享实例 namespace=fm-test。
TEST_REDIS_HOST=redis
TEST_NACOS_ADDR=nacos:8848
# 旧测试共享账号：仅保留用于回滚；测试应用已改用每服务账号
TEST_MYSQL_APP_USER=fm_test_app
TEST_MYSQL_APP_PASSWORD=

# 测试每服务运行时账号（只授 DML）；密码留空时由 scripts/ensure-test-secrets.sh 生成
TEST_FM_USER_DB_USER=fm_test_user_app
TEST_FM_USER_DB_PASSWORD=
TEST_FM_CHAT_DB_USER=fm_test_chat_app
TEST_FM_CHAT_DB_PASSWORD=
TEST_FM_READER_DB_USER=fm_test_reader_app
TEST_FM_READER_DB_PASSWORD=
TEST_FM_GAME_DB_USER=fm_test_game_app
TEST_FM_GAME_DB_PASSWORD=
TEST_FM_MUSIC_DB_USER=fm_test_music_app
TEST_FM_MUSIC_DB_PASSWORD=

# 测试每服务迁移账号（只给一次性迁移 Job，不注入业务容器）
TEST_FM_USER_DB_MIGRATE_USER=fm_test_user_migrate
TEST_FM_USER_DB_MIGRATE_PASSWORD=
TEST_FM_CHAT_DB_MIGRATE_USER=fm_test_chat_migrate
TEST_FM_CHAT_DB_MIGRATE_PASSWORD=
TEST_FM_READER_DB_MIGRATE_USER=fm_test_reader_migrate
TEST_FM_READER_DB_MIGRATE_PASSWORD=
TEST_FM_GAME_DB_MIGRATE_USER=fm_test_game_migrate
TEST_FM_GAME_DB_MIGRATE_PASSWORD=
TEST_FM_MUSIC_DB_MIGRATE_USER=fm_test_music_migrate
TEST_FM_MUSIC_DB_MIGRATE_PASSWORD=

# 测试环境 tf-user 管理员密码（与生产 USER_ADMIN_PASSWORD 隔离，留空由脚本生成）
TEST_USER_ADMIN_PASSWORD=
TEST_WEB_PORT=18088
TEST_GATEWAY_PORT=18080
TEST_USER_PORT=18101
TEST_CHAT_PORT=18102
TEST_READER_PORT=18103
TEST_GAME_PORT=18104
TEST_MUSIC_PORT=18105
# 测试镜像 tag 独立于生产，避免误拉 :latest
TF_TEST_USER_TAG=test
TF_TEST_CHAT_TAG=test
TF_TEST_READER_TAG=test
TF_TEST_GAME_TAG=test
TF_TEST_MUSIC_TAG=test
TF_TEST_GATEWAY_TAG=test
TF_TEST_WEB_TAG=test
