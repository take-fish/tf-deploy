# FishMatrix 集中机环境变量（复制为 .env 并按需修改；全部变量在 compose 中均有默认值）
MYSQL_ROOT_PASSWORD=fishmatrix
MYSQL_PORT=3306
REDIS_PORT=6379
ES_PORT=9200
NACOS_PORT=8848
GATEWAY_PORT=8080
TF_GATEWAY_TAG=latest
CONSOLE_PORT=8301
TF_CONSOLE_TAG=latest
WEB_PORT=8088
TF_WEB_TAG=latest
# 流水线控制台（tf-console）用的 GitHub token：只读即可（classic 无 scope / fine-grained 只读 public 权限），
# 用途仅是把 API 配额从匿名 60/h 提升到 5000/h；留空则控制台自动降级（30 分钟一轮 + 页面提示）
GITHUB_TOKEN=

# ── 网关上游（默认使用集中机 compose 服务名；分机服务可改为 http://<IP>:<端口>）──
# 留空即使用 compose 默认值
TF_CHAT_URL=
TF_READER_URL=
TF_GAME_URL=
TF_MUSIC_URL=
TF_USER_URL=

# ── 业务服务层（docker-compose.services.yml）──
# 这些值由集中机初始化时生成，填写后分机侧才可复用中间件
MYSQL_APP_USER=fm_app
MYSQL_APP_PASSWORD=
NACOS_ADMIN_PASSWORD=
SQL_INIT_MODE=always

# 业务服务端口与镜像 tag（默认即可；固定版本时改 tag）
USER_PORT=8101
CHAT_PORT=8102
READER_PORT=8103
GAME_PORT=8104
MUSIC_PORT=8105
TF_USER_TAG=latest
TF_CHAT_TAG=latest
TF_READER_TAG=latest
TF_GAME_TAG=latest
TF_MUSIC_TAG=latest

# 分机部署时覆盖为集中机地址（集中机全栈运行保留默认 mysql/redis/nacos:8848）
# MYSQL_HOST=10.28.25.234
# REDIS_HOST=10.28.25.234
# NACOS_ADDR=10.28.25.234:8848
